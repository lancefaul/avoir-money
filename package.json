{
  "name": "@budget-tracker/root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "preinstall": "npx only-allow pnpm",
    "audit": "pnpm audit --audit-level=high",
    "audit:signatures": "pnpm audit --signatures",
    "audit:outdated": "pnpm outdated -r",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "husky": "9.1.7",
    "prettier": "3.5.3",
    "react-doctor": "0.9.3",
    "turbo": "2.8.21",
    "typescript": "5.9.3",
    "typescript-eslint": "8.34.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.1.7": ">=1.1.17 <2",
      "brace-expansion@^2.0.2": ">=2.1.3 <3",
      "brace-expansion@^5.0.2": ">=5.0.9",
      "brace-expansion@^5.0.5": ">=5.0.9",
      "defu": ">=6.1.5",
      "effect": ">=3.20.0",
      "fast-uri": ">=3.1.5",
      "js-yaml": ">=4.3.1",
      "lodash": ">=4.18.0",
      "nanoid": ">=3.3.17",
      "postcss": ">=8.5.18",
      "seroval": ">=1.5.3",
      "undici": ">=7.29.0 <8",
      "ws": ">=8.21.0 <9"
    }
  }
}
