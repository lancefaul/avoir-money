# ============================================================
# Supply Chain Security Hardening
# See: .kiro/specs/supply-chain-hardening/requirements.md
# ============================================================

# Block all lifecycle scripts (postinstall, preinstall, install).
# Prevents malicious packages from executing arbitrary code during install.
# If a legitimate package needs scripts (e.g., esbuild native binaries),
# allowlist it via pnpm.onlyBuiltDependencies in package.json.
ignore-scripts=true

# Require exact versions when running `pnpm add <pkg>`.
# Prevents future developers from accidentally adding caret ranges.
save-exact=true

# Pin the registry URL explicitly.
# Prevents registry substitution via environment variables or machine-level .npmrc.
registry=https://registry.npmjs.org/

# Enforce strict peer dependency resolution.
# Fails install if peer dependency requirements conflict.
strict-peer-dependencies=true

# Auto-install peer dependencies (matches current lockfile behavior).
auto-install-peers=true

# Enforce the packageManager field strictly.
# Rejects install if the pnpm version doesn't match package.json's packageManager field.
package-manager-strict=true
